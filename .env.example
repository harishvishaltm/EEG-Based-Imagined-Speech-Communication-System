# OpenAI API configuration (Leave empty to use deterministic offline fallback)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.3
LLM_MAX_TOKENS=40

# Compute device ("cpu" or "cuda")
USE_CUDA=false
DEVICE=cpu

# Model checkpoint filename in models/ directory
MODEL_FILENAME=kara_one_model.pth

# CORS allowed frontend origins
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173,http://127.0.0.1:3000

# File Upload Limits
MAX_UPLOAD_SIZE_MB=50
